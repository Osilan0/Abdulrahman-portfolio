# Copy to .env (local) or add these in Vercel > Project > Settings > Environment Variables.

# Main AI provider (Groq by default: free, fast, OpenAI-compatible). Only the key is required.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=paste-your-key-here
LLM_MODEL=openai/gpt-oss-120b

# Backup model, used when the main one fails or hits its free limit.
# Left as is, it uses the same Groq key with a second model, which has its own free limits.
# To use another provider instead, also fill in FALLBACK_BASE_URL and FALLBACK_API_KEY. FALLBACK_MODEL=none turns it off.
FALLBACK_MODEL=openai/gpt-oss-20b
FALLBACK_BASE_URL=
FALLBACK_API_KEY=

# Optional: only accept chat requests from your own site. Separate several addresses with commas,
# for example https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGIN=
RATE_LIMIT_PER_10_MIN=20
